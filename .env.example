# Copy to .env (gitignored). Only needed for infrastructure work; `bun dev` needs none of this.

# Local development (all optional)
# DATABASE_PATH=./data/atlas.db
# PORT=3000
# SITE_URL=https://contextatlas.dev

# scripts/cloudflare-setup.ts — API token with: Zone Read, DNS Edit, Zone Rulesets Edit (cache rules),
# Cache Purge, Account Cloudflare Tunnel Edit, Access: Apps and Policies Edit, Access: Service Tokens Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DOMAIN=contextatlas.dev

# Optional, scripts/cloudflare-setup.ts: DNS verification for search engines (docs/deploy.md, Discoverability)
# GOOGLE_SITE_VERIFICATION=   # the TXT value Search Console shows, with or without "google-site-verification="
# BING_SITE_VERIFICATION=     # the CNAME name Bing Webmaster Tools shows (it points to verify.bing.com)

# scripts/vps-bootstrap.sh
TUNNEL_TOKEN=
DEPLOY_PUBLIC_KEY=

# scripts/vps.sh (SSH through the tunnel; values printed by cloudflare-setup)
DEPLOY_SSH_HOST=ssh.contextatlas.dev
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# DEPLOY_SSH_KEY_FILE=~/.ssh/contextatlas_deploy
