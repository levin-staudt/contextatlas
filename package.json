{
  "name": "contextatlas",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @contextatlas/server dev",
    "build": "bun run --filter @contextatlas/server build",
    "start": "bun run --filter @contextatlas/server start",
    "deploy": "bun scripts/deploy.ts",
    "test": "bun run --filter @contextatlas/web build && bun test",
    "typecheck": "bun run --filter @contextatlas/web typegen && tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "biome check . && bun run typecheck && bun run test",
    "db:generate": "bun run --filter @contextatlas/core db:generate",
    "cloudflare:setup": "bun scripts/cloudflare-setup.ts",
    "deploy:redirect": "bun run --filter @contextatlas/redirect deploy",
    "seed": "bun run --filter @contextatlas/server seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
